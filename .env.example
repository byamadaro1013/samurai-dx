# バクソク内容証明 購入・配布の設定(本番ではVercel等のサーバー環境変数に設定する)
# 値はすべてダミー。NEXT_PUBLIC_ を付けないこと。

# 完了画面・メールのリンクに使うサイトURL(ローカルでは http://localhost:8001)
SITE_URL=https://www.samuraidx.co.jp

# Stripe シークレットキー(未設定なら購入APIは「販売準備中」を返す)
STRIPE_SECRET_KEY=sk_test_dummy
# Stripe Webhook の署名シークレット(エンドポイント: /api/bakusoku/webhook)
STRIPE_WEBHOOK_SECRET=whsec_dummy
# 任意。Stripeで作ったPrice IDを使う場合(9,800円・JPYであること)。未設定ならコード側の9,800円で決済
STRIPE_PRICE_ID=

# Resend(購入案内メール)
RESEND_API_KEY=re_dummy
BAKUSOKU_MAIL_FROM="バクソク内容証明 <noreply@samuraidx.co.jp>"

# 配布ファイルの実URL(購入確認後にここへリダイレクトする)
BAKUSOKU_DOWNLOAD_URL_WINDOWS=https://example.com/bakusoku/BakusokuNaiyoushoumei-Setup.exe
BAKUSOKU_DOWNLOAD_URL_MAC=https://example.com/bakusoku/BakusokuNaiyoushoumei.dmg
